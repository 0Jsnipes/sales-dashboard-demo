# Firebase web app configuration (Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Database ID shown in the Firestore database selector.
NEXT_PUBLIC_FIREBASE_DATABASE_ID=default
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=

# Firebase Admin SDK service-account values. Never expose or commit these.
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_ID=default
FIREBASE_STORAGE_BUCKET=

# Inbound email import
NEXT_PUBLIC_REPORTS_INBOUND_EMAIL=
REPORTS_INBOUND_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REPORTS_QUERY="in:inbox has:attachment is:unread label:reports"
GMAIL_PROCESSED_LABEL_ID=
GMAIL_REPORTS_MAX_MESSAGES=10
# Random value of at least 16 characters. Vercel sends it as a Bearer token to cron routes.
CRON_SECRET=
# Firestore collection configured in the Firebase Trigger Email extension.
FIREBASE_TRIGGER_EMAIL_COLLECTION=mail
